<% let pageTitle = 'Trips Management - Vaishnavi Tours'; %>
<%- include('../../layouts/admin_header') %>






<div class="d-flex justify-between align-center flex-wrap gap-2 mb-3">
    <div>
        <h1 style="font-size: 18px; font-weight: 700; margin: 0; color: var(--dark-950);">Active Trips & Dispatch Telemetry</h1>
        <p style="color: var(--slate-500); margin: 2px 0 0 0; font-size: 12.5px;">
            Real-time journey control, odometer kilometers tracking, and payment-based trip completion enforcement.
        </p>
    </div>
    <div class="d-flex align-center gap-2">
        <span class="badge badge-warning" style="font-size: 11px;">
            <%= openCount %> Open Trips
        </span>
        <% if (unpaidCompletedTripsCount > 0) { %>
            <span class="badge badge-danger" style="font-size: 11px;">
                <%= unpaidCompletedTripsCount %> Incomplete (Pending Payment)
            </span>
        <% } %>
    </div>
</div>

<% if (session('success')) { %>
    <div class="alert alert-success mb-3" style="background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; padding: 0.75rem 1rem; border-radius: 6px;">
        <%- icon('check-circle', { size: 14, class: 'me-1 inline' }) %> <%= session('success') %>
    </div>
<% } %>

<!-- Quick Status Filter Tabs -->
<div class="d-flex align-center gap-1 mb-3" style="border-bottom: 2px solid var(--slate-200);">
    <a href="<%= (globalThis.routeHelper || route)('admin.trips.index') %>" 
       style="padding: 0.45rem 0.85rem; font-size: 12.5px; font-weight: 600; text-decoration: none; border-bottom: 2px solid <%= !request()?.has('trip_status') && !request()?.has('payment_status') ? '#2563EB' : 'transparent' %>; color: <%= !request()?.has('trip_status') && !request()?.has('payment_status') ? '#2563EB' : 'var(--slate-600)' %>; margin-bottom: -2px;">
       All Trips
    </a>
    <a href="<%= (globalThis.routeHelper || route)('admin.trips.index', {'trip_status' : 'Open', 'payment_status' : 'pending_payment'}) %>" 
       style="padding: 0.45rem 0.85rem; font-size: 12.5px; font-weight: 600; text-decoration: none; border-bottom: 2px solid <%= request('payment_status') === 'pending_payment' ? '#DC2626' : 'transparent' %>; color: <%= request('payment_status') === 'pending_payment' ? '#DC2626' : 'var(--slate-600)' %>; margin-bottom: -2px;">
       Incomplete (Pending Payment)
    </a>
    <a href="<%= (globalThis.routeHelper || route)('admin.trips.index', {'trip_status' : 'Open'}) %>" 
       style="padding: 0.45rem 0.85rem; font-size: 12.5px; font-weight: 600; text-decoration: none; border-bottom: 2px solid <%= request('trip_status') === 'Open' && !request()?.has('payment_status') ? '#D97706' : 'transparent' %>; color: <%= request('trip_status') === 'Open' && !request()?.has('payment_status') ? '#D97706' : 'var(--slate-600)' %>; margin-bottom: -2px;">
       Open Trips
    </a>
    <a href="<%= (globalThis.routeHelper || route)('admin.trips.index', {'trip_status' : 'Closed'}) %>" 
       style="padding: 0.45rem 0.85rem; font-size: 12.5px; font-weight: 600; text-decoration: none; border-bottom: 2px solid <%= request('trip_status') === 'Closed' ? '#059669' : 'transparent' %>; color: <%= request('trip_status') === 'Closed' ? '#059669' : 'var(--slate-600)' %>; margin-bottom: -2px;">
       Closed Trips
    </a>
</div>

<!-- Filters Bar -->
<div class="card mb-3" style="padding: 0.75rem 1rem; background: #fff; border: 1px solid var(--slate-200); border-radius: 6px;">
    <form method="GET" action="<%= (globalThis.routeHelper || route)('admin.trips.index') %>" class="d-flex align-center gap-2 flex-wrap">
        <div style="flex: 1; min-width: 200px;">
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by Trip ID, Booking ID, Route..." value="<%= request('search') %>">
        </div>
        <div style="min-width: 170px;">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- All Journey Statuses --</option>
                <% ((['Scheduled', 'Driver Assigned', 'Trip Started', 'On The Way', 'Completed', 'Cancelled']) || []).forEach((st, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                    <option value="<%= st %>" <%= request('status') === st ? 'selected' : '' %>><%= st %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <% if (request()?.hasAny(['search', 'status', 'trip_status', 'payment_status'])) { %>
            <a href="<%= (globalThis.routeHelper || route)('admin.trips.index') %>" class="btn btn-outline btn-sm">Reset</a>
        <% } %>
    </form>
</div>

<!-- Trips Table -->
<div class="card" style="background: #fff; border: 1px solid var(--slate-200); border-radius: 8px;">
    <div class="table-responsive">
        <table class="data-table" style="width: 100%; font-size: 12.5px;">
            <thead>
                <tr>
                    <th>Trip ID</th>
                    <th>Booking ID</th>
                    <th>Customer</th>
                    <th>Route</th>
                    <th>Vehicle</th>
                    <th>Driver</th>
                    <th>Journey Status</th>
                    <th>Payment / Closure</th>
                    <th style="text-align: right; min-width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if ((trips) && (Array.isArray(trips) ? (trips).length > 0 : Object.keys(trips).length > 0)) { (Array.isArray(trips) ? (trips) : Object.values(trips)).forEach((trip, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                    <tr>
                        <td style="font-weight: 700; font-family: monospace;">
                            <a href="<%= (globalThis.routeHelper || route)('admin.trips.show', trip?.id) %>" style="color: #2563EB;">
                                #TRIP-<%= str_pad(trip?.id, 4, '0', STR_PAD_LEFT) %>
                            </a>
                        </td>
                        <td>
                            <% if (trip?.booking) { %>
                                <a href="<%= (globalThis.routeHelper || route)('admin.bookings.show', trip?.booking_id) %>" style="font-weight: 700; color: #4F46E5;">
                                    <%= trip?.booking?.booking_id %>
                                </a>
                                <span class="badge badge-secondary" style="font-size: 10px;"><%= trip?.booking?.booking_category ?? 'WEB' %></span>
                            <% } else { %>
                                <span style="color: var(--slate-400);">-</span>
                            <% } %>
                        </td>
                        <td style="font-weight: 600;">
                            <%= trip?.booking?.customer?.name ?? 'Guest' %>
                            <div style="font-size: 11px; color: var(--slate-500);"><%= trip?.booking?.customer?.phone ?? '' %></div>
                        </td>
                        <td>
                            <div style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <%= trip?.booking?.pickup_location ?? 'Bilaspur' %> 
                                <% if (trip?.booking?.via_location) { %>
                                    <span style="color: var(--slate-400);">via <%= trip?.booking?.via_location %></span>
                                <% } %>
                                &rarr; <%= trip?.booking?.destination ?? 'Raipur' %>
                            </div>
                        </td>
                        <td style="white-space: nowrap;">
                            <% if (trip?.vehicle) { %>
                                <div style="font-weight: 600;"><%= trip?.vehicle?.name %></div>
                                <div style="font-size: 10.5px; color: var(--slate-500);"><%= trip?.vehicle?.registration_number %></div>
                            <% } else { %>
                                <span style="color: #dc2626; font-size: 11px;">Unassigned</span>
                            <% } %>
                        </td>
                        <td style="white-space: nowrap;">
                            <% if (trip?.driver) { %>
                                <div style="font-weight: 600;"><%= trip?.driver?.name %></div>
                                <div style="font-size: 10.5px; color: var(--slate-500);"><%= trip?.driver?.mobile %></div>
                            <% } else { %>
                                <span style="color: #dc2626; font-size: 11px;">Unassigned</span>
                            <% } %>
                        </td>
                        <td style="white-space: nowrap;">
                            <span class="badge badge-sm
                                <%= trip?.status === 'Completed' || trip?.journey_status === 'Journey Completed' ? 'badge-success' : '' %>
                                <%= in_array(trip?.status, ['Driver Assigned', 'Scheduled']) ? 'badge-primary' : '' %>
                                <%= in_array(trip?.status, ['Started', 'Trip Started', 'On The Way']) ? 'badge-warning' : '' %>
                                <%= trip?.status === 'Cancelled' ? 'badge-danger' : '' %>
                            ">
                                <%= trip?.journey_status  ||  trip?.status %>
                            </span>
                        </td>
                        <td style="white-space: nowrap;">
                            <%  var balance = (trip?.booking?.balance_amount ?? 0); %>
                            <% if (trip?.trip_status === 'Closed') { %>
                                <span class="badge badge-dark" style="font-size: 10.5px;"><%- icon('check', { size: 11, class: 'me-1 inline' }) %> Closed</span>
                            <% } else { %>
                                <% if (balance > 0) { %>
                                    <span class="badge badge-danger" style="font-size: 10.5px;">Due: ₹<%= number_format(balance, 2) %></span>
                                <% } else { %>
                                    <span class="badge badge-success" style="font-size: 10.5px;">Paid (Ready to Close)</span>
                                <% } %>
                            <% } %>
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <a href="<%= (globalThis.routeHelper || route)('admin.trips.show', trip?.id) %>" class="btn btn-primary btn-sm" style="padding: 2px 7px; font-size: 11px;">
                                Manage
                            </a>
                            <button type="button" class="btn btn-outline btn-sm" style="padding: 2px 7px; font-size: 11px;" onclick="openModal('tripModal<%= trip?.id %>')">
                                Odometer
                            </button>
                        </td>
                    </tr>

                    <!-- Modal: Update Trip Status & Odometer -->
                    <div id="tripModal<%= trip?.id %>" class="custom-modal" style="display: none;">
                        <div class="custom-modal-content">
                            <div class="d-flex justify-between align-center mb-3">
                                <h3 style="font-size: 15px; font-weight: 700; margin: 0;">Update Trip #TRIP-<%= str_pad(trip?.id, 4, '0', STR_PAD_LEFT) %></h3>
                                <button type="button" onclick="closeModal('tripModal<%= trip?.id %>')" style="background: none; border: none; font-size: 18px; cursor: pointer;"><%- icon('x', { size: 18 }) %></button>
                            </div>
                            <form action="<%= (globalThis.routeHelper || route)('admin.trips.update', trip?.id) %>" method="POST">
                                <%- csrfField() %>
                                <input type="hidden" name="_method" value="PUT">
                                <div class="form-group mb-2">
                                    <label class="form-label" style="font-size: 11.5px; font-weight: 600;">Journey Status</label>
                                    <select name="status" class="form-select form-select-sm" required>
                                        <% ((['Driver Assigned', 'Trip Started', 'On The Way', 'Completed', 'Cancelled']) || []).forEach((st, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                                            <option value="<%= st %>" <%= trip?.status === st ? 'selected' : '' %>><%= st %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="grid grid-2 gap-2 mb-2">
                                    <div>
                                        <label class="form-label" style="font-size: 11px; font-weight: 600;">Start Odometer</label>
                                        <input type="number" name="start_odometer" class="form-control form-control-sm" value="<%= trip?.start_odometer %>" placeholder="e.g. 45200">
                                    </div>
                                    <div>
                                        <label class="form-label" style="font-size: 11px; font-weight: 600;">End Odometer</label>
                                        <input type="number" name="end_odometer" class="form-control form-control-sm" value="<%= trip?.end_odometer %>" placeholder="e.g. 45340">
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label" style="font-size: 11px; font-weight: 600;">Route Notes / Checkpoint</label>
                                    <input type="text" name="route_notes" class="form-control form-control-sm" value="<%= trip?.route_notes %>" placeholder="e.g. Mangla Bypass toll crossed">
                                </div>
                                <div class="d-flex justify-end gap-2">
                                    <button type="button" class="btn btn-outline btn-sm" onclick="closeModal('tripModal<%= trip?.id %>')">Cancel</button>
                                    <button type="submit" class="btn btn-primary btn-sm">Update Trip</button>
                                </div>
                            </form>
                        </div>
                    </div>
                <% }); } else { %>
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 2.5rem 1rem; color: var(--slate-500);">
                            No active trips found matching your criteria.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (trips?.hasPages()) { %>
        <div style="padding: 0.75rem 1rem; border-top: 1px solid var(--slate-200);">
            <%= trips?.links() %>
        </div>
    <% } %>
</div>

<style>
.custom-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(2px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}
.custom-modal-content {
    background: #ffffff;
    border-radius: 8px;
    max-width: 480px;
    width: 100%;
    padding: 1.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
}
</style>

<script>
function openModal(id) {
    var m = document.getElementById(id);
    if (m) m.style.display = 'flex';
}
function closeModal(id) {
    var m = document.getElementById(id);
    if (m) m.style.display = 'none';
}
window.onclick = function(event) {
    if (event.target.classList.contains('custom-modal')) {
        event.target.style.display = 'none';
    }
}
</script>


<%- include('../../layouts/admin_footer') %>
