<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data['meta']['title'] ?? 'Business Report' %> — Vaishnavi Tours (<%= data['fromDate'] %> to <%= data['toDate'] %>)</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1E293B;
            margin: 20px;
            font-size: 11px;
            background: #fff;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #CBD5E1;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }
        .company-title {
            font-size: 18px;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: 0.5px;
        }
        .company-sub {
            color: #64748B;
            font-size: 10px;
            margin-top: 2px;
        }
        .report-category {
            font-size: 13px;
            font-weight: 800;
            color: #2563EB;
            margin-top: 4px;
        }
        .kpi-row {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }
        .kpi-box {
            flex: 1;
            min-width: 120px;
            border: 1px solid #E2E8F0;
            padding: 8px 12px;
            border-radius: 6px;
            background: #F8FAFC;
        }
        .kpi-box .label {
            color: #64748B;
            font-size: 9px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .kpi-box .val {
            font-size: 14px;
            font-weight: 800;
            margin-top: 2px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 10px;
        }
        th, td {
            border: 1px solid #CBD5E1;
            padding: 5px 7px;
            text-align: left;
        }
        th {
            background: #F1F5F9;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 9px;
            letter-spacing: 0.2px;
        }
        tr:nth-child(even) td {
            background: #F8FAFC;
        }
        @media print {
            .no-print { display: none !important; }
            body { margin: 0; }
            th { background: #F1F5F9 !important; -webkit-print-color-adjust: exact; }
            .kpi-box { background: #F8FAFC !important; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom: 15px; display: flex; justify-content: flex-end; gap: 10px;">
        <button onclick="window.print()" style="padding: 7px 16px; background: #2563EB; color: #fff; border: none; border-radius: 5px; font-weight: 700; cursor: pointer; font-size: 12px;">
            <%- icon('printer', { size: 14, class: 'me-1 inline' }) %> Print / Save as PDF
        </button>
        <button onclick="window.close()" style="padding: 7px 16px; background: #64748B; color: #fff; border: none; border-radius: 5px; font-weight: 700; cursor: pointer; font-size: 12px;">
            Close
        </button>
    </div>

    <div class="header">
        <div>
            <div class="company-title">VAISHNAVI TOURS & TAXI SERVICE</div>
            <div class="company-sub">Official Operational, Fleet & Revenue Ledger</div>
            <div class="report-category"><%= data['meta']['title'] ?? 'Business Report' %></div>
        </div>
        <div style="text-align: right; font-size: 10px; color: #475569;">
            <div><strong>Report Period:</strong> <%= date('d M Y', strtotime(data['fromDate'])) %> &ndash; <%= date('d M Y', strtotime(data['toDate'])) %></div>
            <div><strong>Generated At:</strong> <%= now()?.format('d M Y, h:i A') %></div>
            <div><strong>Generated By:</strong> <%= auth()?.user()?.name ?? 'Administrator' %></div>
            <div><strong>Records Count:</strong> <%= count(data['exportRows'] ?? data['rows']) %></div>
        </div>
    </div>

    <% if (!empty(data['kpis'])) { %>
        <div class="kpi-row">
            <% ((data['kpis']) || []).forEach((kpi, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                <div class="kpi-box">
                    <div class="label"><%= kpi['label'] %></div>
                    <div class="val" style="color: <%= kpi['color'] ?? '#0F172A' %>;"><%= kpi['value'] %></div>
                </div>
            <% }); %>
        </div>
    <% } %>

    <table>
        <thead>
            <tr>
                <th style="width: 25px;">#</th>
                <% (Object.entries((data['columns']) || {})).forEach(([colKey, colLabel], _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                    <th><%= colLabel %></th>
                <% }); %>
            </tr>
        </thead>
        <tbody>
            <%  var rows = data['exportRows'] ?? data['rows']; %>
            <% if ((rows) && (Array.isArray(rows) ? (rows).length > 0 : Object.keys(rows).length > 0)) { (Array.isArray(rows) ? (rows).map((v, i) => [i, v]) : Object.entries(rows)).forEach(([idx, row], _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                <%  var r = row; %>
                <tr>
                    <td style="color: #64748B;"><%= idx + 1 %></td>
                    <% (Object.entries((data['columns']) || {})).forEach(([colKey, colLabel], _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                        <td><%= r[colKey] ?? '' %></td>
                    <% }); %>
                </tr>
            <% }); } else { %>
                <tr>
                    <td colspan="<%= count(data['columns']) + 1 %>" style="text-align: center; padding: 25px; color: #94A3B8;">
                        No records found matching the selected filters.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>
