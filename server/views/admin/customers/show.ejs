<% let pageTitle = 'Customer Profile'; %>
<%- include('../../layouts/admin_header') %>


@section('title', 'Customer: ' . $user->name)



<div class="d-flex justify-between align-center flex-wrap gap-2 mb-4">
    <div>
        <a href="<%= (globalThis.routeHelper || route)('admin.customers.index') %>" style="font-size: 0.875rem; color: var(--slate-600); font-weight: 600;">
            ← Back to Customer Directory
        </a>
        <h1 style="font-size: 1.65rem; font-weight: 800; margin: 4px 0 0 0;"><%= user?.name %></h1>
        <p style="color: var(--slate-500); font-size: 0.875rem; margin: 2px 0 0 0;">Passenger account profile, lifetime value, and booking history.</p>
    </div>
</div>

<!-- Customer Metrics -->
<div class="grid grid-3 gap-4 mb-4">
    <div class="kpi-card">
        <div class="kpi-icon" style="background: #eff6ff; color: #2563eb;"><%- icon('car-front', { size: 24, class: '', style: '' }) %></div>
        <div class="kpi-label">Total Bookings</div>
        <div class="kpi-value"><%= totalBookings %></div>
        <div class="kpi-sub">Total trips created</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon" style="background: #f0fdf4; color: #16a34a;"><%- icon('circle-check', { size: 24, class: '', style: '' }) %></div>
        <div class="kpi-label">Completed Trips</div>
        <div class="kpi-value"><%= completedTrips %></div>
        <div class="kpi-sub">Successfully fulfilled journeys</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon" style="background: #fef3c7; color: #d97706;"><%- icon('wallet', { size: 24, class: '', style: '' }) %></div>
        <div class="kpi-label">Lifetime Spend</div>
        <div class="kpi-value">₹<%= number_format(totalSpent, 2) %></div>
        <div class="kpi-sub">Successful payments recorded</div>
    </div>
</div>

<div class="grid grid-3 gap-4">
    <!-- Left 1 Col: Profile Card -->
    <div>
        <div class="card mb-4">
            <% const custType = user?.customer?.customer_type || 'individual'; %>
            <div class="d-flex justify-between align-center mb-3">
                <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0;">
                    <%- icon('user', { size: 20, class: 'text-primary', style: 'margin-right: 6px;' }) %> Account Details
                </h3>
                <% if (custType === 'corporate') { %>
                    <span class="badge" style="background: #EFF6FF; color: #1E40AF; border: 1px solid #BFDBFE; font-size: 0.75rem; font-weight: 800;">
                        <%- icon('building-2', { size: 14, class: 'me-1 inline' }) %> Corporate
                    </span>
                <% } else if (custType === 'travel_partner') { %>
                    <span class="badge" style="background: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; font-size: 0.75rem; font-weight: 800;">
                        <%- icon('handshake', { size: 14, class: 'me-1 inline' }) %> Travel Partner
                    </span>
                <% } else { %>
                    <span class="badge" style="background: #F8FAFC; color: #475569; border: 1px solid #E2E8F0; font-size: 0.75rem; font-weight: 700;">
                        <%- icon('user', { size: 14, class: 'me-1 inline' }) %> Individual
                    </span>
                <% } %>
            </div>

            <!-- Corporate Specific Block -->
            <% if (custType === 'corporate') { %>
                <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem; margin-bottom: 1rem;">
                    <div style="font-size: 0.75rem; font-weight: 700; color: #2563EB; text-transform: uppercase;">Company / Organization</div>
                    <div style="font-weight: 800; font-size: 1.15rem; color: var(--dark-900);">
                        <%= user?.customer?.company_name || user?.name %>
                    </div>
                    <% if (user?.customer?.gstin) { %>
                        <div style="margin-top: 6px; font-size: 0.85rem;">
                            <strong>GSTIN:</strong> 
                            <code style="background: #EFF6FF; color: #1E40AF; padding: 2px 6px; border-radius: 4px; font-weight: 800;"><%= user?.customer?.gstin %></code>
                        </div>
                    <% } %>
                    <% if (user?.customer?.contact_person) { %>
                        <div style="margin-top: 4px; font-size: 0.85rem; color: var(--slate-600);">
                            <strong>Contact Person:</strong> <%= user?.customer?.contact_person %>
                        </div>
                    <% } %>
                    <% if (user?.customer?.billing_address) { %>
                        <div style="margin-top: 6px; font-size: 0.8rem; color: var(--slate-600); border-top: 1px dashed var(--slate-200); padding-top: 6px;">
                            <strong>Billing Address:</strong><br><%= user?.customer?.billing_address %>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Travel Partner Specific Block -->
            <% if (custType === 'travel_partner') { %>
                <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 8px; padding: 0.85rem; margin-bottom: 1rem;">
                    <div style="font-size: 0.75rem; font-weight: 700; color: #D97706; text-transform: uppercase;">Agency / Travel Partner</div>
                    <div style="font-weight: 800; font-size: 1.15rem; color: var(--dark-900);">
                        <%= user?.customer?.partner_name || user?.name %>
                    </div>
                    <% if (user?.customer?.gstin) { %>
                        <div style="margin-top: 6px; font-size: 0.85rem;">
                            <strong>GSTIN:</strong> 
                            <code style="background: #FEF3C7; color: #92400E; padding: 2px 6px; border-radius: 4px; font-weight: 800;"><%= user?.customer?.gstin %></code>
                        </div>
                    <% } %>
                    <% if (user?.customer?.contact_person) { %>
                        <div style="margin-top: 4px; font-size: 0.85rem; color: var(--slate-600);">
                            <strong>Partner Representative:</strong> <%= user?.customer?.contact_person %>
                        </div>
                    <% } %>
                    <% if (user?.customer?.partner_commission) { %>
                        <div style="margin-top: 4px; font-size: 0.85rem; color: #B45309; font-weight: 700;">
                            <strong>Commission Terms:</strong> <%= user?.customer?.partner_commission %>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Primary Contact & Phone -->
            <% if (custType === 'individual') { %>
                <div style="font-weight: 800; font-size: 1.15rem; color: var(--dark-900);"><%= user?.name %></div>
            <% } %>
            <div style="margin-top: 6px; font-size: 0.9rem;">
                <%- icon('phone', { size: 14, class: '', style: 'margin-right: 4px;' }) %>
                <a href="tel:<%= user?.phone %>" style="font-weight: 700; color: #2563EB;"><%= user?.phone %></a>
            </div>
            <div style="font-size: 0.9rem; color: var(--slate-600); margin-top: 2px;"><%- icon('mail', { size: 12, class: 'me-1 inline' }) %> <%= user?.email %></div>

            <% if (user?.customer) { %>
                <% if (user?.customer?.alternate_phone) { %>
                    <div style="font-size: 0.85rem; color: var(--slate-500); margin-top: 4px;">Alt Phone: <%= user?.customer?.alternate_phone %></div>
                <% } %>
                <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--slate-200); font-size: 0.85rem; color: var(--slate-600);">
                    <strong>Operating / Pickup Address:</strong><br>
                    <%= user?.customer?.address ?? 'Bilaspur' %><br>
                    <%= user?.customer?.city ?? 'Bilaspur' %>, <%= user?.customer?.state ?? 'Chhattisgarh' %> - <%= user?.customer?.pincode ?? '495001' %>
                </div>
                <% if (user?.customer?.notes) { %>
                    <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--slate-200); font-size: 0.8rem; color: var(--slate-500);">
                        <strong>Notes / Instructions:</strong><br><%= user?.customer?.notes %>
                    </div>
                <% } %>
            <% } %>

            <div style="margin-top: 1rem; font-size: 0.8rem; color: var(--slate-400);">
                Joined: <%= user?.created_at?.format('d M Y, h:i A') %>
            </div>

            <div class="mt-3 pt-3" style="border-top: 1px solid var(--slate-200);">
                <a href="/admin/bookings/create?customer_id=<%= user?.id %>" class="btn btn-primary btn-sm" style="width: 100%; justify-content: center; font-weight: 700;">
                    + Create Booking for Customer
                </a>
            </div>
        </div>
    </div>

    <!-- Right 2 Cols: Bookings & Payments -->
    <div style="grid-column: span 2;">
        <!-- Bookings History -->
        <div class="card mb-4">
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem;"><%- icon('calendar-days', { size: 16, class: 'me-1 inline' }) %> Bookings History</h3>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Route</th>
                            <th>Date</th>
                            <th>Fare (₹)</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if ((user?.bookings) && (Array.isArray(user?.bookings) ? (user?.bookings).length > 0 : Object.keys(user?.bookings).length > 0)) { (Array.isArray(user?.bookings) ? (user?.bookings) : Object.values(user?.bookings)).forEach((b, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                            <tr>
                                <td>
                                    <a href="<%= (globalThis.routeHelper || route)('admin.bookings.show', b?.id) %>" style="font-weight: 800; color: var(--dark-900);">
                                        #<%= b?.booking_id %>
                                    </a>
                                </td>
                                <td><%= b?.pickup_location %> &rarr; <%= b?.destination %></td>
                                <td><%= b?.travel_date ? b?.travel_date?.format('d M Y') : '' %></td>
                                <td style="font-weight: 800;">₹<%= number_format(b?.total_amount, 2) %></td>
                                <td>
                                    <span class="badge badge-sm badge-secondary"><%= b?.booking_status %></span>
                                </td>
                                <td>
                                    <a href="<%= (globalThis.routeHelper || route)('admin.bookings.show', b?.id) %>" class="btn btn-outline btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                                        View
                                    </a>
                                </td>
                            </tr>
                        <% }); } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color: var(--slate-500);">No bookings recorded for this passenger yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Payments Ledger -->
        <div class="card">
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem;"><%- icon('credit-card', { size: 16, class: 'me-1 inline' }) %> Payments Ledger</h3>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Booking Ref</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if ((user?.payments) && (Array.isArray(user?.payments) ? (user?.payments).length > 0 : Object.keys(user?.payments).length > 0)) { (Array.isArray(user?.payments) ? (user?.payments) : Object.values(user?.payments)).forEach((p, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                            <tr>
                                <td style="font-family: monospace; font-size: 0.85rem;"><%= p?.payment_id %></td>
                                <td>
                                    <a href="<%= (globalThis.routeHelper || route)('admin.bookings.show', p?.booking_id) %>" style="color: var(--primary-dark); font-weight: 600;">
                                        #<%= p?.booking?.booking_id ?? p?.booking_id %>
                                    </a>
                                </td>
                                <td style="font-weight: 800; color: #16a34a;">₹<%= number_format(p?.amount, 2) %></td>
                                <td><%= p?.payment_method %></td>
                                <td><span class="badge badge-sm badge-success"><%= p?.status %></span></td>
                                <td style="font-size: 0.8rem; color: var(--slate-500);"><%= p?.created_at?.format('d M Y, h:i A') %></td>
                            </tr>
                        <% }); } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4" style="color: var(--slate-500);">No payment transactions recorded yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<%- include('../../layouts/admin_footer') %>
