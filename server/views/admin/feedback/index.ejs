<% let pageTitle = 'Customer Feedback & Reviews'; %>
<%- include('../../layouts/admin_header') %>






<div class="mb-4 d-flex justify-between align-center flex-wrap gap-2">
    <div>
        <h1 style="font-size: 1.65rem; font-weight: 800; margin: 0; color: var(--dark-900);">Customer Feedback & Reviews</h1>
        <p style="color: var(--slate-500); margin: 2px 0 0 0; font-size: 0.875rem;">Moderate customer ratings, testimonials, and Google review satisfaction.</p>
    </div>
    <div class="d-flex align-center gap-2">
        <span class="badge badge-success" style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">
            ⭐ <%= number_format(averageRating, 1) %> / 5.0 (<%= totalCount %> Reviews)
        </span>
    </div>
</div>

<!-- Feedback Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Rating</th>
                    <th>Review Comment</th>
                    <th>Booking Ref</th>
                    <th>Website Display</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                <% if ((feedbacks) && (Array.isArray(feedbacks) ? (feedbacks).length > 0 : Object.keys(feedbacks).length > 0)) { (Array.isArray(feedbacks) ? (feedbacks) : Object.values(feedbacks)).forEach((item, _idx, _arr) => { const loop = { index: _idx, iteration: _idx + 1, first: _idx === 0, last: _idx === _arr.length - 1, count: _arr.length }; %>
                    <tr>
                        <td style="white-space: nowrap; font-size: 0.8rem; color: var(--slate-500);">
                            <%= item?.created_at?.format('d M Y') %>
                        </td>
                        <td>
                            <div style="font-weight: 800; color: var(--dark-900);"><%= item?.name %></div>
                            <% if (item?.email) { %>
                                <small style="color: var(--slate-500);"><%= item?.email %></small>
                            <% } %>
                        </td>
                        <td>
                            <div style="color: #F59E0B; font-weight: 800; font-size: 0.9rem;">
                                <% for(let r = 1; r <= 5; r++) { %><%- icon('star-filled', { size: 13, style: r <= item?.rating ? 'color:#f59e0b;display:inline;' : 'color:#cbd5e1;display:inline;' }) %><% } %>
                                <span style="color: var(--dark-900); font-size: 0.8rem; margin-left: 4px;">(<%= item?.rating %>/5)</span>
                            </div>
                        </td>
                        <td>
                            <div style="font-size: 0.85rem; color: var(--dark-800); max-width: 320px;">
                                "<%= item?.comment %>"
                            </div>
                        </td>
                        <td>
                            <% if (item?.booking) { %>
                                <a href="<%= (globalThis.routeHelper || route)('admin.bookings.show', item?.booking_id) %>" style="font-weight: 700; color: var(--primary-dark);">
                                    #<%= item?.booking?.booking_id %>
                                </a>
                            <% } else { %>
                                <span style="color: var(--slate-400);">General</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (item?.is_public) { %>
                                <span class="badge badge-success"><%- icon('check', { size: 12, class: 'me-1 inline' }) %> Published</span>
                            <% } else { %>
                                <span class="badge badge-secondary">Hidden</span>
                            <% } %>
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <form method="POST" action="<%= (globalThis.routeHelper || route)('admin.feedback.toggle-status', item?.id) %>" style="display: inline;">
                                <%- csrfField() %>
                                <button type="submit" class="btn btn-outline btn-sm">
                                    <%= item?.is_public ? 'Hide' : 'Approve & Publish' %>
                                </button>
                            </form>
                            <form method="POST" action="<%= (globalThis.routeHelper || route)('admin.feedback.destroy', item?.id) %>" style="display: inline;" onsubmit="return confirm('Delete this review?');">
                                <%- csrfField() %>
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-outline btn-sm" style="color: #DC2626; border-color: #FCA5A5;">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }); } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 3rem; color: var(--slate-400);">
                            No customer feedback recorded yet.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (feedbacks?.hasPages()) { %>
        <div style="padding: 1rem; border-top: 1px solid var(--slate-200);">
            <%= feedbacks?.links() %>
        </div>
    <% } %>
</div>


<%- include('../../layouts/admin_footer') %>
