<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrf_token() %>">
    <title>@yield('title', 'Customer Portal') - Vaishnavi Tours</title>
    <link rel="stylesheet" href="<%= asset('css/style.css') %>">
    <link rel="icon" type="image/png" href="<%= asset('favicon.png') %>">
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('styles')
</head>
<body style="background-color: var(--slate-100);">

    <!-- Customer Topbar -->
    <header style="background: var(--dark-900); color: #fff; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div class="container d-flex align-center justify-between flex-wrap gap-2">
            <a href="<%= (globalThis.routeHelper || route)('home') %>" class="brand-logo-wrap brand-logo-dark">
                <div class="brand-logo-badge" style="width: 32px; height: 32px; border-radius: 6px;">
                    <img src="<%= asset('assets/branding/vaishnavi-tours-logo.png') %>" alt="Vaishnavi Tours Logo">
                </div>
                <div>
                    <div class="logo-brand" style="color: #fff; font-size: 13.5px; font-weight: 600;">Vaishnavi <span style="color: var(--accent);">Tours</span></div>
                    <div class="logo-sub" style="color: var(--slate-400); font-size: 10px; font-weight: 500;">Customer Portal</div>
                </div>
            </a>

            <div class="d-flex align-center gap-2">
                <a href="<%= (globalThis.routeHelper || route)('booking') %>" class="btn btn-primary btn-sm">
                    <%- icon('car', { size: 14, class: '', style: '' }) %> Quick Book Taxi
                </a>
                <div class="d-flex align-center gap-1" style="background: rgba(255,255,255,0.06); padding: 0.25rem 0.65rem; border-radius: var(--radius-sm);">
                    <%- icon('user', { size: 13, class: 'text-slate-400', style: '' }) %>
                    <span style="font-weight: 600; font-size: 12px; color: #fff;"><%= Auth.user()?.name %></span>
                </div>
                <form action="<%= (globalThis.routeHelper || route)('logout') %>" method="POST">
                    <%- csrfField() %>
                    <button type="submit" class="btn btn-outline btn-sm" style="color: #fff; border-color: rgba(255,255,255,0.2); font-size: 11.5px; height: 30px;">Logout</button>
                </form>
            </div>
        </div>
    </header>

    <!-- Sub Navigation Tabs -->
    <div style="background: #fff; border-bottom: 1px solid var(--slate-200); padding: 0.35rem 0;">
        <div class="container d-flex align-center gap-1 flex-wrap">
            <a href="<%= (globalThis.routeHelper || route)('customer.dashboard') %>" class="btn btn-sm <%= request()?.routeIs('customer.dashboard') ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('trending-up', { size: 13, class: '', style: '' }) %> Dashboard
            </a>
            <a href="<%= (globalThis.routeHelper || route)('customer.bookings.index') %>" class="btn btn-sm <%= request()?.routeIs('customer.bookings.index') && !request('filter') ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('calendar-check', { size: 13, class: '', style: '' }) %> My Bookings
            </a>
            <a href="<%= (globalThis.routeHelper || route)('customer.bookings.index') %>?filter=upcoming" class="btn btn-sm <%= request('filter') === 'upcoming' ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('calendar', { size: 13, class: '', style: '' }) %> Upcoming Trips
            </a>
            <a href="<%= (globalThis.routeHelper || route)('customer.bookings.index') %>?filter=payments" class="btn btn-sm <%= request('filter') === 'payments' ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('credit-card', { size: 13, class: '', style: '' }) %> Invoices & Payments
            </a>
            <a href="<%= (globalThis.routeHelper || route)('customer.notifications') %>" class="btn btn-sm <%= request()?.routeIs('customer.notifications') ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('bell', { size: 13, class: '', style: '' }) %> Notifications
            </a>
            <a href="<%= (globalThis.routeHelper || route)('customer.profile') %>" class="btn btn-sm <%= request()?.routeIs('customer.profile') ? 'btn-primary' : 'btn-outline' %>">
                <%- icon('settings', { size: 13, class: '', style: '' }) %> Profile
            </a>
            <a href="<%= (globalThis.routeHelper || route)('home') %>" class="btn btn-sm btn-outline" style="margin-left: auto; color: var(--slate-600);">
                <%- icon('external-link', { size: 12, class: '', style: '' }) %> Public Site
            </a>
        </div>
    </div>

    <!-- Main Body -->
    <main class="container" style="padding-top: 1.25rem; padding-bottom: 2rem;">
        <% if (session('success')) { %>
            <div class="alert alert-success"><%- icon('circle-check', { size: 16, class: '', style: '' }) %> <%= session('success') %></div>
        <% } %>
        <% if (session('error')) { %>
            <div class="alert alert-danger"><%- icon('alert-circle', { size: 16, class: '', style: '' }) %> <%= session('error') %></div>
        <% } %>
        <% if (session('info')) { %>
            <div class="alert alert-info"><%- icon('info', { size: 16, class: '', style: '' }) %> <%= session('info') %></div>
        <% } %>

        @yield('content')
    </main>

    <!-- Global Digits-Only Mobile Number Enforcer -->
    <script>
    (function() {
        function isPhoneInput(el) {
            if (!el || !el.tagName || el.tagName.toLowerCase() !== 'input') return false;
            const type = (el.type || '').toLowerCase();
            const name = (el.name || '').toLowerCase();
            const id = (el.id || '').toLowerCase();
            return type === 'tel' ||
                   name === 'mobile' ||
                   name === 'phone' ||
                   name.includes('mobile') ||
                   name.includes('phone') ||
                   id === 'mobile' ||
                   id === 'phone' ||
                   el.classList.contains('phone-input');
        }

        document.addEventListener('input', function(e) {
            if (isPhoneInput(e.target)) {
                const clean = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
                if (e.target.value !== clean) {
                    e.target.value = clean;
                }
            }
        }, true);

        document.addEventListener('keypress', function(e) {
            if (isPhoneInput(e.target)) {
                if (e.ctrlKey || e.metaKey || e.altKey) return;
                if (e.key && e.key.length === 1 && !/[0-9]/.test(e.key)) {
                    e.preventDefault();
                    return false;
                }
                if (e.target.value.length >= 10 && e.target.selectionStart === e.target.selectionEnd) {
                    e.preventDefault();
                    return false;
                }
            }
        }, true);

        document.addEventListener('paste', function(e) {
            if (isPhoneInput(e.target)) {
                setTimeout(function() {
                    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
                }, 10);
            }
        }, true);
    })();
    </script>
    @stack('scripts')
</body>
</html>
