<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken() %>">

    <!-- Page Title & Primary SEO Metadata -->
    <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : (typeof title !== 'undefined' && title ? title : config.seo.default_title) %></title>
    <meta name="description" content="<%= typeof meta_description !== 'undefined' && meta_description ? meta_description : config.seo.default_description %>">
    <meta name="keywords" content="<%= typeof meta_keywords !== 'undefined' && meta_keywords ? meta_keywords : config.seo.default_keywords %>">
    <meta name="author" content="Vaishnavi Tours">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="<%= currentUrl %>">

    <!-- Local SEO Geo Meta Tags (Bilaspur, Chhattisgarh) -->
    <meta name="geo.region" content="IN-CT">
    <meta name="geo.placename" content="Bilaspur, Chhattisgarh">
    <meta name="geo.position" content="22.0797;82.1409">
    <meta name="ICBM" content="22.0797, 82.1409">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Vaishnavi Tours">
    <meta property="og:locale" content="en_IN">
    <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : config.seo.default_title %>">
    <meta property="og:description" content="<%= typeof meta_description !== 'undefined' ? meta_description : config.seo.default_description %>">
    <meta property="og:url" content="<%= currentUrl %>">
    <meta property="og:image" content="<%= config.app.url %>/assets/images/hero-taxi.jpg">
    <meta property="og:image:alt" content="Vaishnavi Tours Taxi & Cab Service Bilaspur">

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : config.seo.default_title %>">
    <meta name="twitter:description" content="<%= typeof meta_description !== 'undefined' ? meta_description : config.seo.default_description %>">
    <meta name="twitter:image" content="<%= config.app.url %>/assets/images/hero-taxi.jpg">

    <!-- Favicon & App Icons -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/build/assets/style-se50KSX5.css">
    <link rel="stylesheet" href="/build/assets/app-CTs3YCme.css">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <!-- Rich Schema.org Structured Data: TaxiService LocalBusiness & WebSite -->
    <script type="application/ld+json">
    <%- JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'TaxiService',
                '@id': config.app.url + '/#taxiservice',
                'name': config.vaishnavi.business_name,
                'description': 'Premier 24/7 taxi and cab service in Bilaspur, Chhattisgarh. Providing verified chauffeur-driven local cabs, outstation travel, and airport transfers.',
                'url': config.app.url,
                'telephone': config.vaishnavi.phone_primary_tel,
                'priceRange': '₹₹',
                'currenciesAccepted': 'INR',
                'paymentAccepted': 'Cash, UPI, Credit Card, Debit Card, Net Banking',
                'logo': {
                    '@type': 'ImageObject',
                    'url': config.app.url + '/assets/branding/vaishnavi-tours-logo.png'
                },
                'image': config.app.url + '/assets/images/hero-taxi.jpg',
                'address': {
                    '@type': 'PostalAddress',
                    'streetAddress': config.vaishnavi.address,
                    'addressLocality': config.vaishnavi.city,
                    'addressRegion': config.vaishnavi.state,
                    'postalCode': config.vaishnavi.pincode,
                    'addressCountry': 'IN'
                },
                'geo': {
                    '@type': 'GeoCoordinates',
                    'latitude': 22.0797,
                    'longitude': 82.1409
                },
                'areaServed': config.seo.service_areas.map(a => ({ '@type': 'City', 'name': a })),
                'sameAs': [config.vaishnavi.whatsapp_link]
            },
            {
                '@type': 'WebSite',
                '@id': config.app.url + '/#website',
                'url': config.app.url,
                'name': config.vaishnavi.business_name
            }
        ]
    }) %>
    </script>
</head>
<body>

    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container top-bar-inner">
            <!-- Desktop Top Bar Content -->
            <div class="top-bar-desktop d-flex align-center justify-between flex-wrap gap-1">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <span style="color: #F1F5F9; font-weight: 500; display: inline-flex; align-items: center;"><%- icon('map-pin', { size: 14, style: 'color: #F59E0B; margin-right: 5px; flex-shrink: 0;' }) %> <%= config.vaishnavi.address %></span>
                    <a href="<%= config.vaishnavi.google_maps_url %>" target="_blank" rel="noopener noreferrer" class="google-reviews-badge" style="color: #202124 !important; text-decoration: none; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; background: #FFFFFF !important; padding: 3px 8px; border-radius: 4px; border: 1px solid #CBD5E1;" title="Verified Google Business Profile">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                        </svg>
                        <span style="color: #202124 !important; font-weight: 700; display: inline-flex; align-items: center; gap: 3px;">4.9 <%- icon('star-filled', { size: 12, style: 'color: #F59E0B;' }) %> Google Reviews</span>
                    </a>
                    <span style="display: inline-flex; align-items: center;"><%- icon('phone', { size: 14, style: 'color: #F59E0B; margin-right: 5px; flex-shrink: 0;' }) %><a href="tel:<%= config.vaishnavi.phone_primary_tel %>" style="color: #FFFFFF; font-weight: 700; text-decoration: none;"><%= config.vaishnavi.phone_primary %></a></span>
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <a href="/contact#emergency" class="top-badge-emergency">
                        <%- icon('life-buoy', { size: 14, style: 'margin-right: 4px;' }) %> 24/7 Road Assistance & Emergency
                    </a>
                    <% if (isAuthenticated) { %>
                        <% if (isAdmin) { %>
                            <a href="/admin/dashboard" class="top-bar-auth-link" style="color: #F59E0B !important; font-weight: 700; text-decoration: none;">
                                <%- icon('settings', { size: 14, style: 'color: #F59E0B; margin-right: 3px;' }) %> Admin Panel
                            </a>
                        <% } else { %>
                            <a href="/customer/dashboard" class="top-bar-auth-link" style="color: #F59E0B !important; font-weight: 700; text-decoration: none;">
                                <%- icon('user', { size: 14, style: 'color: #F59E0B; margin-right: 3px;' }) %> My Account
                            </a>
                        <% } %>
                        <span style="color: #475569; margin: 0 2px;">|</span>
                        <form action="/logout" method="POST" style="display: inline;">
                            <%- csrfField() %>
                            <button type="submit" class="top-bar-logout-btn" style="background: none; border: none; color: #CBD5E1; cursor: pointer; font-size: 11.5px; font-weight: 600; padding: 0;">Logout</button>
                        </form>
                    <% } else { %>
                        <a href="/login" style="color: #E2E8F0; font-weight: 600;">Login</a>
                        <span style="color: #475569; margin: 0 2px;">|</span>
                        <a href="/register" style="color: #E2E8F0; font-weight: 600;">Register</a>
                    <% } %>
                </div>
            </div>

            <!-- Mobile Top Bar Content -->
            <div class="top-bar-mobile">
                <a href="tel:<%= config.vaishnavi.phone_primary_tel %>" class="top-bar-mobile-call">
                    <%- icon('phone', { size: 13, style: 'color: #F59E0B; margin-right: 4px;' }) %>
                    <span>Call: <strong><%= config.vaishnavi.phone_primary %></strong></span>
                </a>
                <a href="/contact#emergency" class="top-badge-emergency" style="font-size: 0.72rem; padding: 2px 7px;">
                    <%- icon('life-buoy', { size: 12, style: 'margin-right: 3px;' }) %> 24/7 Support
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar">
        <div class="container nav-wrapper">
            <a href="/" class="logo">
                <div class="brand-logo-badge">
                    <img src="/assets/branding/vaishnavi-tours-logo.png" alt="Vaishnavi Tours Logo">
                </div>
                <div>
                    <div class="logo-brand">Vaishnavi <span>Tours</span></div>
                    <div class="logo-sub">24/7 Cabs & Car Rentals</div>
                </div>
            </a>

            <!-- Mobile Toggle Button -->
            <button class="mobile-nav-toggle" id="mobile-nav-btn" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav-drawer" type="button">
                <%- icon('menu', { size: 22 }) %>
            </button>

            <!-- Nav Links (Desktop) -->
            <div class="nav-links" id="nav-links-menu">
                <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
                <a href="/services" class="nav-link <%= currentPath.startsWith('/services') ? 'active' : '' %>">Services</a>
                <a href="/ambulance-services" class="nav-link <%= currentPath === '/ambulance-services' ? 'active' : '' %>">Ambulance Services</a>
                <a href="/rates" class="nav-link <%= currentPath === '/rates' ? 'active' : '' %>">Rates</a>
                <a href="/vehicles" class="nav-link <%= currentPath === '/vehicles' ? 'active' : '' %>">Vehicles</a>
                <a href="/service-network" class="nav-link <%= currentPath === '/service-network' || currentPath === '/network' ? 'active' : '' %>">Service Network</a>
                <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a>
                <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
                <% if (isAuthenticated) { %>
                    <% if (isAdmin) { %>
                        <a href="/admin/dashboard" class="nav-link" style="color: #D97706; font-weight: 700;">Admin Panel</a>
                    <% } else { %>
                        <a href="/customer/dashboard" class="nav-link" style="color: #D97706; font-weight: 700;">My Account</a>
                    <% } %>
                <% } else { %>
                    <a href="/login" class="nav-link <%= currentPath === '/login' ? 'active' : '' %>">Login</a>
                <% } %>

                <div class="nav-actions d-flex align-center gap-2">
                    <a href="tel:<%= config.vaishnavi.phone_primary_tel %>" class="btn btn-outline btn-sm" style="color: var(--dark-950); font-weight: 700; border-color: var(--primary); text-decoration: none;">
                        <%- icon('phone', { size: 15, style: 'margin-right: 6px;' }) %> <%= config.vaishnavi.phone_primary %>
                    </a>
                    <a href="/booking" class="btn btn-primary btn-sm"><%- icon('car-front', { size: 15, style: 'margin-right: 6px;' }) %> Book Taxi</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile Navigation Backdrop Overlay -->
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>

    <!-- Mobile Navigation Drawer -->
    <aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="mobile-drawer-header">
            <a href="/" class="logo d-flex align-center gap-2">
                <div class="brand-logo-badge" style="width: 38px; height: 38px;">
                    <img src="/assets/branding/vaishnavi-tours-logo.png" alt="Vaishnavi Tours Logo">
                </div>
                <div>
                    <div class="logo-brand" style="font-size: 1.15rem; color: #172033;">Vaishnavi <span>Tours</span></div>
                    <div class="logo-sub" style="font-size: 0.68rem; color: #4B5563;">24/7 Cabs & Car Rentals</div>
                </div>
            </a>
            <button class="mobile-drawer-close" id="mobile-drawer-close-btn" aria-label="Close navigation" type="button">
                <%- icon('x', { size: 22 }) %>
            </button>
        </div>

        <div class="mobile-drawer-body">
            <nav class="mobile-drawer-nav">
                <a href="/" class="mobile-nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
                <a href="/services" class="mobile-nav-link <%= currentPath.startsWith('/services') ? 'active' : '' %>">Services</a>
                <a href="/ambulance-services" class="mobile-nav-link <%= currentPath === '/ambulance-services' ? 'active' : '' %>">Ambulance Services</a>
                <a href="/rates" class="mobile-nav-link <%= currentPath === '/rates' ? 'active' : '' %>">Rates</a>
                <a href="/vehicles" class="mobile-nav-link <%= currentPath === '/vehicles' ? 'active' : '' %>">Vehicles</a>
                <a href="/service-network" class="mobile-nav-link <%= currentPath === '/service-network' || currentPath === '/network' ? 'active' : '' %>">Service Network</a>
                <a href="/about" class="mobile-nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a>
                <a href="/contact" class="mobile-nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
                <% if (isAuthenticated) { %>
                    <% if (isAdmin) { %>
                        <a href="/admin/dashboard" class="mobile-nav-link" style="color: #D97706; font-weight: 700;">Admin Panel</a>
                    <% } else { %>
                        <a href="/customer/dashboard" class="mobile-nav-link" style="color: #D97706; font-weight: 700;">My Account</a>
                    <% } %>
                <% } else { %>
                    <a href="/login" class="mobile-nav-link <%= currentPath === '/login' ? 'active' : '' %>">Login</a>
                <% } %>
            </nav>

            <div class="mobile-drawer-actions">
                <a href="/booking" class="btn btn-primary" style="width: 100%; justify-content: center; min-height: 46px; font-weight: 800;">
                    <%- icon('car-front', { size: 18, style: 'margin-right: 6px;' }) %> BOOK A TAXI
                </a>
                <a href="tel:<%= config.vaishnavi.phone_primary_tel %>" class="btn btn-outline" style="width: 100%; justify-content: center; min-height: 44px; color: var(--dark-950); font-weight: 700; border-color: var(--primary); text-decoration: none;">
                    <%- icon('phone', { size: 16, style: 'margin-right: 6px;' }) %> Call <%= config.vaishnavi.phone_primary %>
                </a>
            </div>
        </div>
    </aside>

    <!-- Flash Alerts -->
    <div class="container" style="margin-top: 1rem;">
        <% if (flash && flash.success) { %>
            <div class="alert alert-success"><%- icon('circle-check', { size: 18, style: 'margin-right: 6px;' }) %> <%= flash.success %></div>
        <% } %>
        <% if (flash && flash.error) { %>
            <div class="alert alert-danger"><%- icon('alert-triangle', { size: 18, style: 'margin-right: 6px;' }) %> <%= flash.error %></div>
        <% } %>
        <% if (flash && flash.info) { %>
            <div class="alert alert-info"><%- icon('info', { size: 18, style: 'margin-right: 6px;' }) %> <%= flash.info %></div>
        <% } %>
    </div>

    <!-- Main Content Container -->
    <main>
