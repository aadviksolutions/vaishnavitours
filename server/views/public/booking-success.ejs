<% let pageTitle = 'Booking Request Received - Vaishnavi Tours'; %>
<%- include('../layouts/app_header') %>

<% const isPaid = booking?.payment_status === 'Paid' || (booking?.paid_amount > 0 && (booking?.balance_amount || 0) <= 0); %>

<section style="padding: 4rem 0 6rem; background: var(--slate-50);">
    <div class="container" style="max-width: 740px;">
        <div class="card" style="text-align: center; padding: 3rem 2.5rem; border-top: 6px solid <%= isPaid ? '#10B981' : 'var(--primary)' %>; box-shadow: var(--shadow-lg);">
            
            <% if (isPaid) { %>
                <div style="width: 76px; height: 76px; background: #DCFCE7; color: #16A34A; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 1.25rem;">
                    ✓
                </div>

                <span class="badge badge-success" style="font-size: 0.95rem; padding: 0.4rem 1.25rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.75rem; display: inline-block;">
                    Booking Confirmed &amp; Payment Verified
                </span>

                <h1 style="font-size: 2.15rem; font-weight: 900; margin-bottom: 0.5rem; color: var(--dark-950);">
                    Thank You, <%= booking?.customer?.name ?? 'Customer' %>!
                </h1>
                <p style="color: var(--slate-600); font-size: 1.05rem; margin-bottom: 2rem;">
                    Your payment of <strong>₹<%= number_format(booking?.paid_amount, 2) %></strong> has been securely captured via Razorpay. Your cab booking is officially confirmed!
                </p>
            <% } else if ((booking?.total_amount ?? 0) <= 0 || (booking?.pricing_details && booking?.pricing_details['is_query'])) { %>
                <div style="width: 76px; height: 76px; background: #FEF3C7; color: #D97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 1.25rem;">
                    ⏳
                </div>

                <span class="badge" style="font-size: 0.95rem; padding: 0.4rem 1.25rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.75rem; display: inline-block; background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D;">
                    Route Query Received
                </span>

                <h1 style="font-size: 2.15rem; font-weight: 900; margin-bottom: 0.5rem; color: var(--dark-950);">
                    Thank You, <%= booking?.customer?.name ?? 'Customer' %>!
                </h1>
                <p style="color: var(--slate-600); font-size: 1.05rem; margin-bottom: 2rem;">
                    Your custom route query for <strong><%= booking?.pickup_location %> to <%= booking?.destination %></strong> has been received. Our dispatch team will review route parameters and share a customized quotation shortly.
                </p>
            <% } else { %>
                <div style="width: 76px; height: 76px; background: #FEF3C7; color: #D97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 1.25rem;">
                    💳
                </div>

                <span class="badge badge-warning" style="font-size: 0.95rem; padding: 0.4rem 1.25rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.75rem; display: inline-block;">
                    Booking Awaiting Payment
                </span>

                <h1 style="font-size: 2.15rem; font-weight: 900; margin-bottom: 0.5rem; color: var(--dark-950);">
                    Thank You, <%= booking?.customer?.name ?? 'Customer' %>!
                </h1>
                <p style="color: var(--slate-600); font-size: 1.05rem; margin-bottom: 2rem;">
                    Your cab request is registered. Complete payment now via Razorpay (UPI, Cards, Netbanking) to automatically confirm your vehicle.
                </p>
            <% } %>

            <!-- Booking Summary Card -->
            <div style="background: #ffffff; border: 1.5px solid var(--slate-200); border-radius: var(--radius-md); padding: 1.75rem; text-align: left; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
                <div class="d-flex justify-between align-center" style="border-bottom: 1.5px solid var(--slate-100); padding-bottom: 0.85rem; margin-bottom: 1rem;">
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">BOOKING ID</span>
                        <div style="color: var(--dark-950); font-size: 1.35rem; font-weight: 900;"><%= booking?.booking_id %></div>
                    </div>
                    <div style="text-align: right;">
                        <span style="color: var(--slate-500); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">BOOKING STATUS</span>
                        <div>
                            <span class="badge <%= isPaid ? 'badge-success' : 'badge-warning' %>" style="font-size: 0.85rem; font-weight: 800;">
                                <%= booking?.booking_status %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-2 gap-3" style="font-size: 0.95rem;">
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Customer:</span>
                        <div style="font-weight: 700; color: var(--dark-900);"><%= booking?.customer?.name ?? 'Customer' %> (<%- icon('phone', { size: 14, class: '', style: 'margin-right: 4px;' }) %> <%= booking?.customer?.phone ?? 'Contact Number' %>)</div>
                    </div>
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Vehicle:</span>
                        <div style="font-weight: 700; color: var(--dark-900);">
                            <%= booking?.vehicle ? booking?.vehicle?.name + ' (' + booking?.vehicle?.vehicle_type + ')' : (booking?.vehicle_category ?? 'AC Cab Category') %>
                        </div>
                    </div>
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Pickup:</span>
                        <div style="font-weight: 700; color: var(--dark-900);"><%= booking?.pickup_location %></div>
                    </div>
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Destination:</span>
                        <div style="font-weight: 700; color: var(--dark-900);"><%= booking?.destination %></div>
                    </div>
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Travel Date:</span>
                        <div style="font-weight: 700; color: var(--dark-900);"><%= booking?.travel_date %></div>
                    </div>
                    <div>
                        <span style="color: var(--slate-500); font-size: 0.8rem; font-weight: 600;">Travel Time:</span>
                        <div style="font-weight: 700; color: var(--dark-900);"><%= booking?.travel_time %></div>
                    </div>
                </div>

                <!-- Fare and Payment Balances -->
                <div style="border-top: 1.5px solid var(--slate-100); padding-top: 1rem; margin-top: 1.25rem;">
                    <div class="d-flex justify-between align-center mb-1">
                        <span style="color: var(--slate-600); font-weight: 600;">Total Fare:</span>
                        <strong style="font-size: 1.15rem; color: var(--dark-950);">₹<%= number_format((booking?.total_amount ?? 0), 2) %></strong>
                    </div>

                    <% if ((booking?.paid_amount ?? 0) > 0) { %>
                        <div class="d-flex justify-between align-center mb-1">
                            <span style="color: var(--slate-600); font-weight: 600;">Paid Amount:</span>
                            <strong style="color: #059669;">₹<%= number_format(booking?.paid_amount, 2) %></strong>
                        </div>
                    <% } %>

                    <% if ((booking?.balance_amount ?? 0) > 0) { %>
                        <div class="d-flex justify-between align-center pt-2" style="border-top: 1px dashed var(--slate-200);">
                            <span style="color: #DC2626; font-weight: 700;">Payable Balance:</span>
                            <strong style="font-size: 1.35rem; color: #DC2626;">₹<%= number_format(booking?.balance_amount, 2) %></strong>
                        </div>
                    <% } %>
                </div>

                <!-- Terms Agreement Notice -->
                <div style="background: #F0FDF4; border: 1.5px solid #BBF7D0; border-radius: var(--radius-md); padding: 1rem 1.25rem; margin-top: 1.25rem; text-align: left; display: flex; align-items: center; gap: 0.75rem;">
                    <%- icon('circle-check', { size: 24, class: '', style: 'color: #16A34A; flex-shrink: 0;' }) %>
                    <div style="font-size: 0.885rem; color: #166534; line-height: 1.5;">
                        <strong>Agreed Terms:</strong> By confirming this booking, you agreed to Vaishnavi Tour's 
                        <a href="/terms-and-conditions" target="_blank" style="color: #15803D; font-weight: 700; text-decoration: underline;">Cancellation Policy &amp; Terms &amp; Conditions</a>.
                    </div>
                </div>
            </div>

            <!-- Razorpay Pay Now Section if Balance > 0 -->
            <% if ((booking?.balance_amount || 0) > 0 && booking?.booking_status !== 'Cancelled') { %>
                <div style="background: #FFFBEB; border: 2px solid #F59E0B; border-radius: var(--radius-md); padding: 2rem 1.5rem; margin-bottom: 2rem;">
                    <h3 style="font-size: 1.25rem; font-weight: 900; color: #78350F; margin-bottom: 0.5rem;">
                        Instant Confirmation with Razorpay
                    </h3>
                    <p style="color: #92400E; font-size: 0.95rem; margin-bottom: 1.25rem;">
                        Pay securely using any UPI app (GPay, PhonePe, Paytm, BHIM), Credit/Debit Card, or Netbanking.
                    </p>

                    <button id="rzpCheckoutBtn" type="button" class="btn btn-primary btn-lg" style="padding: 1rem 2.25rem; font-size: 1.15rem; font-weight: 800; border-radius: var(--radius-md); box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4); display: inline-flex; align-items: center; gap: 8px;">
                        <%- icon('shield-check', { size: 20 }) %>
                        <span>Pay ₹<%= number_format(booking?.balance_amount, 2) %> Online Now</span>
                    </button>

                    <div id="bookingPayMsg" style="display: none; margin-top: 1rem; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 600;"></div>

                    <div style="margin-top: 1rem; font-size: 0.8rem; color: #B45309;">
                        Or open dedicated payment page: <a href="/pay/<%= booking?.id %>" style="color: #78350F; font-weight: 700; text-decoration: underline;">vaishnavitours.com/pay/<%= booking?.booking_id %></a>
                    </div>
                </div>
            <% } %>

            <!-- Invoices and Customer Portal Links -->
            <% if (isPaid) { %>
                <div style="margin-bottom: 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
                    <a href="/invoice/<%= booking?.id %>" target="_blank" class="btn btn-outline">
                        <%- icon('file-text', { size: 16, style: 'margin-right: 4px;' }) %> View GST Tax Invoice
                    </a>
                    <% if (isAuthenticated) { %>
                        <a href="/customer/bookings/<%= booking?.id %>" class="btn btn-primary">
                            Track Booking &amp; Journey Details →
                        </a>
                    <% } %>
                </div>
            <% } %>

            <!-- If customer is not logged in: Ask whether they want to create an account -->
            <% if (!isAuthenticated) { %>
                <div style="background: #F8FAFC; border: 1.5px dashed var(--slate-300); border-radius: var(--radius-md); padding: 1.5rem; text-align: left; margin-bottom: 2rem;">
                    <div class="d-flex align-start gap-3">
                        <div class="icon-box icon-box-md icon-box-primary"><%- icon('user', { size: 24, class: '', style: '' }) %></div>
                        <div style="flex: 1;">
                            <h4 style="font-size: 1.05rem; font-weight: 800; color: var(--dark-950); margin-bottom: 0.25rem;">
                                Create an Account for Real-Time Trip Tracking
                            </h4>
                            <p style="color: var(--slate-600); font-size: 0.875rem; margin-bottom: 1rem;">
                                An account lets you track chauffeur allocation live, monitor vehicle location, view payment receipts, and download GST tax invoices.
                            </p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/register?phone=<%= booking?.customer?.phone || '' %>&name=<%= encodeURIComponent(booking?.customer?.name || '') %>" class="btn btn-primary btn-sm">
                                    Create My Account
                                </a>
                                <a href="/login" class="btn btn-outline btn-sm">
                                    Log In to Existing Account
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else if (!isPaid) { %>
                <div style="margin-bottom: 2rem;">
                    <a href="/customer/bookings/<%= booking?.id %>" class="btn btn-outline">
                        View in Customer Dashboard →
                    </a>
                </div>
            <% } %>

            <p style="font-size: 0.875rem; color: var(--slate-500); margin-bottom: 2rem;">
                Our central dispatch desk will contact you at <strong><%= booking?.customer?.phone ?? 'your registered phone' %></strong>. For urgent queries, reach out to our support team.
            </p>

            <div class="d-flex justify-center gap-3 flex-wrap">
                <a href="/" class="btn btn-outline">← Back to Home</a>
                <a href="/contact" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;"><%- icon('message-square', { size: 16, class: '', style: '' }) %><span>Contact Support</span></a>
            </div>
        </div>
    </div>
</section>

<!-- Razorpay Checkout Integration -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const payBtn = document.getElementById('rzpCheckoutBtn');
    const msgBox = document.getElementById('bookingPayMsg');

    if (!payBtn) return;

    function showMsg(type, text) {
        msgBox.style.display = 'block';
        if (type === 'error') {
            msgBox.style.background = '#FEE2E2';
            msgBox.style.border = '1px solid #FCA5A5';
            msgBox.style.color = '#991B1B';
        } else if (type === 'success') {
            msgBox.style.background = '#DCFCE7';
            msgBox.style.border = '1px solid #86EFAC';
            msgBox.style.color = '#166534';
        } else {
            msgBox.style.background = '#EFF6FF';
            msgBox.style.border = '1px solid #BFDBFE';
            msgBox.style.color = '#1E40AF';
        }
        msgBox.innerText = text;
    }

    payBtn.addEventListener('click', async function () {
        try {
            payBtn.disabled = true;
            payBtn.innerText = 'Connecting to Razorpay...';
            showMsg('info', 'Creating secure payment order...');

            const orderRes = await fetch('/api/payments/razorpay/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ booking_id: '<%= booking?.id %>' })
            });

            const orderData = await orderRes.json();
            if (!orderRes.ok || !orderData.success) {
                throw new Error(orderData.message || 'Could not initiate payment');
            }

            const options = {
                key: orderData.key_id,
                amount: orderData.amount,
                currency: orderData.currency || 'INR',
                name: 'Vaishnavi Tours',
                description: 'Payment for Booking #' + (orderData.booking?.booking_id || '<%= booking?.booking_id %>'),
                order_id: orderData.order_id,
                prefill: {
                    name: orderData.customer?.name || '',
                    email: orderData.customer?.email || '',
                    contact: orderData.customer?.phone || ''
                },
                theme: {
                    color: '#F59E0B'
                },
                modal: {
                    ondismiss: function () {
                        payBtn.disabled = false;
                        payBtn.innerText = 'Pay ₹<%= number_format(booking?.balance_amount, 2) %> Online Now';
                        showMsg('info', 'Payment dismissed. You can retry at any time.');
                    }
                },
                handler: async function (response) {
                    try {
                        payBtn.innerText = 'Verifying Payment...';
                        showMsg('info', 'Verifying signature and confirming booking...');

                        const verifyRes = await fetch('/api/payments/razorpay/verify', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature,
                                booking_id: '<%= booking?.id %>'
                            })
                        });

                        const verifyData = await verifyRes.json();
                        if (!verifyRes.ok || !verifyData.success) {
                            throw new Error(verifyData.message || 'Verification failed');
                        }

                        showMsg('success', 'Payment verified! Refreshing confirmation...');
                        setTimeout(function () {
                            window.location.href = '/booking-success/<%= booking?.id %>?paid=1';
                        }, 1200);
                    } catch (verifyErr) {
                        console.error('Verify error:', verifyErr);
                        payBtn.disabled = false;
                        payBtn.innerText = 'Retry Payment';
                        showMsg('error', 'Verification error: ' + verifyErr.message);
                    }
                }
            };

            const rzp = new Razorpay(options);
            rzp.on('payment.failed', function (failResp) {
                payBtn.disabled = false;
                payBtn.innerText = 'Retry Payment';
                const errDesc = failResp.error ? failResp.error.description : 'Payment declined or failed';
                showMsg('error', 'Payment Failed: ' + errDesc);
            });

            rzp.open();
        } catch (err) {
            console.error('Payment error:', err);
            payBtn.disabled = false;
            payBtn.innerText = 'Pay ₹<%= number_format(booking?.balance_amount, 2) %> Online Now';
            showMsg('error', err.message || 'Payment launch failed');
        }
    });
});
</script>

<%- include('../layouts/app_footer') %>
