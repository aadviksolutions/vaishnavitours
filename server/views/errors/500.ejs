<% let pageTitle = '500 - Server Issue | Vaishnavi Tours'; %>
<%- include('../layouts/app_header') %>

<section style="padding: 5rem 0 7rem; background: var(--slate-50); min-height: 70vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 640px; text-align: center;">
        <div class="card" style="padding: 3rem 2rem; border-top: 6px solid #DC2626; box-shadow: var(--shadow-lg);">
            <div style="font-size: 5rem; font-weight: 900; color: #DC2626; line-height: 1; margin-bottom: 0.5rem;">
                500
            </div>
