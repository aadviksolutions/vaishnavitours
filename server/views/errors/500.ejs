                <a href="/" class="btn btn-primary btn-lg" style="display: inline-flex; align-items: center; gap: 8px;">
                    <%- icon('home', { size: 18 }) %>
                    <span>Return to Home</span>
                </a>
                <a href="tel:+919244784443" class="btn btn-outline btn-lg" style="display: inline-flex; align-items: center; gap: 8px;">
                    <%- icon('phone-call', { size: 18 }) %>
                    <span>Call +91 9244784443</span>
                </a>
            </div>
        </div>
    </div>
</section>

<%- include('../layouts/app_footer') %>
