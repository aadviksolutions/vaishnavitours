APP_NAME="Vaishnavi Tours"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# External MySQL Database Configuration (Production requires external host; do not use localhost/127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=external-mysql-host.example.com
DB_PORT=3306
DB_DATABASE=vaishnavi_tours
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
# Optional SSL Certificate Authority path for managed DB providers (AWS RDS, PlanetScale, Aiven, etc.)
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

# Serverless & Container Optimized Drivers
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Email Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bookings@vaishnavitours.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage for Customer Uploads (S3 / Cloudflare R2 / AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Future Payment Gateway Integration (Razorpay / Cashfree / Stripe)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Vite Asset Configuration
VITE_APP_NAME="${APP_NAME}"
